---
import Layout   from '../../../layouts/Layout.astro';
import Navbar   from '../../../components/Navbar.astro';
import Footer   from '../../../components/Footer.astro';
import BlogList from '../../../components/blogs/BlogList.astro';
import { getPosts } from '../../../utils/blogs';
import { useTranslations } from '../../../i18n/utils';

const t = useTranslations('es');
const altLangHrefs = { en: '/en/blogs' };
const posts = await getPosts('es');
---

<Layout lang="es" title="Blogs — SigmaPro" description={t.meta.blogsDescription}>
  <Navbar slot="navbar" lang="es" altLangHrefs={altLangHrefs} />
  <BlogList lang="es" posts={posts} />
  <Footer slot="footer" lang="es" />
</Layout>
